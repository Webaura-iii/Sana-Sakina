rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Only users with admins/{uid}.active == true are admins
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Products: public catalogue read; only admins may create/update/delete
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Settings (store, reviews, faqs): public read for storefront; only admins write
    match /settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Orders: customers may create a new pending order only (storefront checkout).
    // Only admins may read, update, or delete orders (admin panel).
    match /orders/{orderId} {
      allow create: if request.resource.data.keys().hasAll([
            'orderNumber', 'customer', 'items', 'total',
            'status', 'paymentStatus', 'paymentMethod'
          ])
        && request.resource.data.status == 'new'
        && request.resource.data.paymentStatus == 'pending'
        && request.resource.data.paymentMethod is string
        && request.resource.data.customer.keys().hasAll([
            'name', 'phone', 'address', 'city', 'state', 'pincode'
          ])
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.total is number
        && request.resource.data.total >= 0;
      allow read, update, delete: if isAdmin();
    }

    // Admin roster: no client writes (manage only via Firebase Console / Admin SDK).
    // A signed-in user may read their own admin doc (for the panel login check).
    // Other admins may read the full admins collection.
    match /admins/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update, delete: if false;
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}